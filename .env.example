# Google Gemini (required)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional model (default: gemini-2.0-flash-lite - better for free tier)
# GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional docs folder override
# DOCS_PATH=C:\path\to\your\docs

# Backend CORS for Vercel + local
# RAG_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:4200

# Frontend (Vercel build-time)
# API_BASE_URL=https://your-api.onrender.com
