# Google Gemini (required)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Chat model (also set this on Render for https://viassist.netlify.app)
GEMINI_MODEL=gemini-3.6-flash
# Alternatives if quota is tight:
# GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_MODEL=gemini-2.0-flash

# Embeddings
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional docs folder override
# DOCS_PATH=C:\path\to\your\docs

# Durable self-learning + embedding cache (survives restarts when path is on a persistent volume)
# Local default: ./data under the process working directory
# VICKY_DATA_DIR=C:\Users\you\vicky-assist-data
# Or set explicit files:
# LEARNED_CHAT_PATH=C:\Users\you\vicky-assist-data\vicky-assist-learned-chats.txt
# EMBEDDING_STORE_PATH=C:\Users\you\vicky-assist-data\vicky-assist-embeddings.json

# Backend CORS for Netlify + local
# RAG_CORS_ORIGINS=https://viassist.netlify.app,https://*.netlify.app,http://localhost:4200

# Frontend (Netlify/Vercel build-time)
# API_BASE_URL=https://viassist.onrender.com
